# Database
DB_USER=gini
DB_PASSWORD=change_me
DB_NAME=gini

# Redis
REDIS_URL=redis://gini-redis:6379/0

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Credential Vault Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=generate-me-with-command-above

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=your-telegram-user-id

# Public base URL of this deployment — used to build outward-facing URLs such as
# the webhook trigger endpoints returned to clients/agents. Set to your real host.
PUBLIC_BASE_URL=https://gini.tail3d4a2.ts.net

# Tailscale — generate a reusable, pre-authorized, non-ephemeral auth key in the
# Tailscale admin console. Only consumed on first start; the tailscale-state
# named volume persists the node identity afterwards, so the key is unused on
# subsequent boots.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
